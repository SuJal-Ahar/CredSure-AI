# CredSure AI Environment Configuration Template

# Server Port
PORT=8000
HOST=127.0.0.1

# AI Underwriter Model Provider: "groq", "gemini", "openai", or "mock" (default: mock for 100% offline execution)
LLM_PROVIDER=mock

# Optional API Keys (Leave blank to use the deterministic offline MockChatModel)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Vector DB & Storage
QDRANT_STORAGE_PATH=./data/qdrant_storage
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Next.js Frontend (in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
